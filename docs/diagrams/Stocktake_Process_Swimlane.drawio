<mxfile host="app.diagrams.net"><diagram id="dlc-wms-stocktake" name="Stocktake Process (Swimlane)"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2740" pageHeight="1000" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Stocktake Process — DLC-WMS" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="600" height="34" as="geometry"/></mxCell><mxCell id="lane_keeper" value="Warehouse Keeper" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#ffffff;swimlaneFillColor=none;strokeColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="2660" height="220" as="geometry"/></mxCell><mxCell id="lane_manager" value="Manager" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#ffffff;swimlaneFillColor=none;strokeColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="2660" height="200" as="geometry"/></mxCell><mxCell id="lane_accountant" value="Accountant" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#ffffff;swimlaneFillColor=none;strokeColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="2660" height="200" as="geometry"/></mxCell><mxCell id="lane_system" value="System" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#ffffff;swimlaneFillColor=none;strokeColor=#000000;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="2660" height="240" as="geometry"/></mxCell><mxCell id="k_start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="100" y="95" width="30" height="30" as="geometry"/></mxCell><mxCell id="k_create" value="Create stocktake&lt;br&gt;(warehouse, product lines, participants)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;arcSize=20;" vertex="1" parent="1"><mxGeometry x="160" y="80" width="170" height="70" as="geometry"/></mxCell><mxCell id="s_validate" value="Validate request&lt;br&gt;(1 open stocktake per warehouse, no duplicate product)&lt;br&gt;Generate code KKxxxxxx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;arcSize=20;" vertex="1" parent="1"><mxGeometry x="160" y="700" width="190" height="80" as="geometry"/></mxCell><mxCell id="s_is_approver" value="Creator is&lt;br&gt;Manager / Super Admin?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="695" width="150" height="90" as="geometry"/></mxCell><mxCell id="s_pending" value="Status PENDING_APPROVAL&lt;br&gt;Notify Managers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;arcSize=20;" vertex="1" parent="1"><mxGeometry x="570" y="800" width="170" height="60" as="geometry"/></mxCell><mxCell id="m_review" value="Review stocktake request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;arcSize=20;" vertex="1" parent="1"><mxGeometry x="570" y="330" width="170" height="60" as="geometry"/></mxCell><mxCell id="m_decide" value="Approve?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="790" y="315" width="120" height="90" as="geometry"/></mxCell><mxCell id="m_reject" value="Reject&lt;br&gt;(reason required)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;arcSize=20;" vertex="1" parent="1"><mxGeometry x="960" y="330" width="150" height="60" as="geometry"/></mxCell><mxCell id="s_rejected" value="Status REJECTED&lt;br&gt;(warehouse not locked)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;arcSize=20;" vertex="1" parent="1"><mxGeometry x="960" y="800" width="150" height="60" as="geometry"/></mxCell><mxCell id="s_end_rejected" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1150" y="815" width="30" height="30" as="geometry"/></mxCell><mxCell id="s_counting" value="Snapshot book quantities&lt;br&gt;Status COUNTING&lt;br&gt;Lock warehouse (no import / export / transfer)&lt;br&gt;Notify staff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;arcSize=20;" vertex="1" parent="1"><mxGeometry x="1220" y="690" width="200" height="90" as="geometry"/></mxCell><mxCell id="k_count" value="Count stock, scan serials,&lt;br&gt;record participants&lt;br&gt;(save counts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;arcSize=20;" vertex="1" parent="1"><mxGeometry x="1220" y="75" width="190" height="80" as="geometry"/></mxCell><mxCell id="s_diff" value="Compute difference per line&lt;br&gt;(diff = count − book)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;arcSize=20;" vertex="1" parent="1"><mxGeometry x="1460" y="700" width="180" height="70" as="geometry"/></mxCell><mxCell id="k_type" value="Difference&lt;br&gt;handling?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1470" y="145" width="150" height="100" as="geometry"/></mxCell><mxCell id="a_import" value="Create import adjustment slip&lt;br&gt;(reference = stocktake)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;arcSize=20;" vertex="1" parent="1"><mxGeometry x="1690" y="485" width="190" height="60" as="geometry"/></mxCell><mxCell id="a_export" value="Create export adjustment slip&lt;br&gt;(reference = stocktake)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;arcSize=20;" vertex="1" parent="1"><mxGeometry x="1690" y="575" width="190" height="60" as="geometry"/></mxCell><mxCell id="k_waiver" value="Choose &quot;Không xử lý&quot; with reason&lt;br&gt;Request waiver confirmation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;arcSize=20;" vertex="1" parent="1"><mxGeometry x="1690" y="170" width="190" height="70" as="geometry"/></mxCell><mxCell id="k_post_import" value="Post import slip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;arcSize=20;" vertex="1" parent="1"><mxGeometry x="1930" y="70" width="160" height="55" as="geometry"/></mxCell><mxCell id="k_post_export" value="Post export slip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;arcSize=20;" vertex="1" parent="1"><mxGeometry x="1930" y="175" width="160" height="55" as="geometry"/></mxCell><mxCell id="m_confirm" value="Confirm waivers&lt;br&gt;(Manager or Accountant,&lt;br&gt;not the person who counted)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;arcSize=20;" vertex="1" parent="1"><mxGeometry x="1930" y="320" width="180" height="80" as="geometry"/></mxCell><mxCell id="k_complete" value="Complete stocktake" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;arcSize=20;" vertex="1" parent="1"><mxGeometry x="2150" y="70" width="150" height="55" as="geometry"/></mxCell><mxCell id="s_ready" value="Ready?&lt;br&gt;≥ 1 participant, adjustment&lt;br&gt;slips POSTED, waivers&lt;br&gt;confirmed" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2150" y="680" width="170" height="120" as="geometry"/></mxCell><mxCell id="s_posted" value="Status POSTED&lt;br&gt;Unlock warehouse&lt;br&gt;Serials: MISSING → LOST,&lt;br&gt;UNEXPECTED → AVAILABLE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;arcSize=20;" vertex="1" parent="1"><mxGeometry x="2370" y="695" width="200" height="90" as="geometry"/></mxCell><mxCell id="s_end" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="2600" y="725" width="30" height="30" as="geometry"/></mxCell><mxCell id="note_cancel" value="Cancel: allowed while DRAFT, PENDING_APPROVAL or COUNTING → status CANCELLED, warehouse unlocked.&lt;br&gt;Posting an adjustment slip re-checks readiness automatically (the stocktake closes itself when nothing is missing)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;fontSize=11;fillColor=#fffde7;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="160" y="920" width="900" height="50" as="geometry"/></mxCell><mxCell id="e_k_start_k_create" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="k_start" target="k_create"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_k_create_s_validate" value="submit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="k_create" target="s_validate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s_validate_s_is_approver" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="s_validate" target="s_is_approver"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s_is_approver_s_pending" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="s_is_approver" target="s_pending"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s_is_approver_s_counting" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="s_is_approver" target="s_counting"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s_pending_m_review" value="notification" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="s_pending" target="m_review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_m_review_m_decide" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="m_review" target="m_decide"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_m_decide_m_reject" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="m_decide" target="m_reject"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_m_reject_s_rejected" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="m_reject" target="s_rejected"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s_rejected_s_end_rejected" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="s_rejected" target="s_end_rejected"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_m_decide_s_counting" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="m_decide" target="s_counting"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s_counting_k_count" value="warehouse locked" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="s_counting" target="k_count"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_k_count_s_diff" value="save counts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="k_count" target="s_diff"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_s_diff_k_type" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="s_diff" target="k_t