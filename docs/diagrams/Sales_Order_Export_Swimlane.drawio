        </mxCell>

        <!-- 3. Save SO in Draft (Lane 2: System) -->
        <mxCell id="node_sys_save_draft" value="Save sales order in&#xa;&quot;Nháp&quot; (Draft) status &amp;&#xa;calculate total amount" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=11;" vertex="1" parent="1">
