@startuml
title Sequence Diagram: UC10 - View Account Details

actor "Admin" as User
boundary "UserDetailPage" as Page
control "UserController" as Controller
control "UserService" as Service
entity "UserRepository" as Repository
database "Database" as Database

User -> Page : Click on an account to view details
activate Page

Page -> Controller : GET /api/v1/users/{id}
activate Controller

Controller -> Service : getUserById(id)
activate Service

Service -> Repository : findById(id)
activate Repository

Repository -> Database : SELECT * FROM users WHERE id = ?
activate Database
Database --> Repository : User data / null
deactivate Database

Repository --> Service : User / null
deactivate Repository

alt User Not Found
    Service --> Controller : throws Exception
    Controller --> Page : 404 Error Response
    Page --> User : Hiển thị thông báo lỗi (Tài khoản không tồn tại)

else User Found
    Service -> Service : mapToDto(User)

    Service --> Controller : UserDto
    deactivate Service
    
    Controller --> Page : 200 OK (ApiResponse)
    deactivate Controller
    
    Page --> User : Hiển thị chi tiết tài khoản
    deactivate Page
end

@enduml
