@startuml

autonumber

actor "Manager" as Actor
boundary "ReportPage" as Page
control "ReportController" as Controller
participant "ReportService" as Service
participant "ReportRepository" as Repository
database "duylongcomputer" as Database

Actor -> Page: Select report type and filters\n(e.g., date range, warehouse, category)
activate Page

Page -> Controller: GET /api/v1/reports/{reportType} (filters)
activate Controller

alt Validation Error (e.g., Start Date > End Date)
    Controller -> Controller: validateParams(filters)
    Controller --> Page: 400 Bad Request (Validation details)
    deactivate Controller
    
    Page --> Actor: Hiển thị lỗi thông số tìm kiếm không hợp lệ
else Valid Parameters
    Controller -> Service: generateReport(reportType, filters)
    activate Service

    Service -> Repository: fetchReportData(reportType, filters)
    activate Repository
    
    Repository -> Database: SELECT COUNT, SUM, GROUP BY... \n(Complex Aggregation Query)
    activate Database
    
    Database --> Repository: Aggregated Result Set
    deactivate Database
    
    Repository --> Service: List[ReportData]
    deactivate Repository
    
    Service -> Service: processAndFormat(List[ReportData])
    note right: Format data for charts, tables,\nand calculate summary metrics
    
    Service --> Controller: ReportResponseDTO
    deactivate Service
    
    Controller --> Page: 200 OK (ReportResponseDTO)
    deactivate Controller
    
    Page --> Actor: Hiển thị biểu đồ và bảng thống kê báo cáo (Dashboard)
end

opt Export Report to Excel/PDF
    Actor -> Page: Click "Export" button
    Page -> Controller: GET /api/v1/reports/{reportType}/export (filters, format)
    activate Controller
    
    Controller -> Service: exportReport(reportType, filters, format)
    activate Service
    
    Service -> Repository: fetchReportData(reportType, filters)
    activate Repository
    Repository --> Service: List[ReportData]
    deactivate Repository
    
    Service -> Service: generateFile(List[ReportData], format)
    note right: Create Excel/PDF file in memory
    
    Service --> Controller: byte[] (File stream)
    deactivate Service
    
    Controller --> Page: 200 OK (Content-Type: application/octet-stream)
    deactivate Controller
    
    Page --> Actor: Tải xuống file báo cáo thành công
end

deactivate Page

@enduml
