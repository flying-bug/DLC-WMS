@startuml UC-57_UpdateExportSlip_Sequence

actor WarehouseStaff as "Warehouse Staff"
boundary UpdateExportSlipPage as "UpdateExportSlipPage"
control InventoryDocumentController as "InventoryDocumentController"
control InventoryDocumentService as "InventoryDocumentService"
entity InventoryDocumentRepository as "InventoryDocumentRepository"
database Database as "Database"

WarehouseStaff -> UpdateExportSlipPage : Modify fields and click "Update"
activate UpdateExportSlipPage

UpdateExportSlipPage -> InventoryDocumentController : PUT /api/v1/exports/{id} (InventoryDocumentRequest)
activate InventoryDocumentController

InventoryDocumentController -> InventoryDocumentService : updateExport(id, req)
activate InventoryDocumentService

InventoryDocumentService -> InventoryDocumentRepository : findExportByIdWithLines(id)
activate InventoryDocumentRepository
InventoryDocumentRepository -> Database : Query export document
activate Database
Database --> InventoryDocumentRepository : InventoryDocument Entity
deactivate Database
InventoryDocumentRepository --> InventoryDocumentService : Optional<InventoryDocument>
deactivate InventoryDocumentRepository

alt Document Not Editable (Status is not DRAFT or SUBMITTED)
    InventoryDocumentService -> InventoryDocumentService : ensureEditable(doc)
    InventoryDocumentService --> InventoryDocumentController : throws BusinessException ("Chi co the cap nhat phieu DRAFT hoac SUBMITTED")
    InventoryDocumentController -> InventoryDocumentController : catch Exception
    InventoryDocumentController -> Database : auditLogService.logEvent(..., "FAILED", "Cập nhật phiếu xuất kho ... thất bại", ...)
    activate Database
    Database --> InventoryDocumentController : saved
    deactivate Database
    InventoryDocumentController --> UpdateExportSlipPage : 400 Bad Request / INV03 (ApiResponse with error message)
    UpdateExportSlipPage --> WarehouseStaff : Display "Invalid inventory document state."
else Document Code Duplicated (when docCode is changed)
    InventoryDocumentService -> InventoryDocumentService : ensureEditable(doc)
    InventoryDocumentService -> InventoryDocumentRepository : existsByDocCodeAndIdNot(requestedCode, id)
    activate InventoryDocumentRepository
    InventoryDocumentRepository -> Database : Query existence with different ID
    activate Database
    Database --> InventoryDocumentRepository : true
    deactivate Database
    InventoryDocumentRepository --> InventoryDocumentService : true
    deactivate InventoryDocumentRepository
    
    InventoryDocumentService --> InventoryDocumentController : throws BusinessException ("Ma phieu xuat kho da ton tai")
    InventoryDocumentController -> InventoryDocumentController : catch Exception
    InventoryDocumentController -> Database : auditLogService.logEvent(..., "FAILED", "Cập nhật phiếu xuất kho ... thất bại", ...)
    activate Database
    Database --> InventoryDocumentController : saved
    deactivate Database
    InventoryDocumentController --> UpdateExportSlipPage : 400 Bad Request / INV01 (ApiResponse with error message)
    UpdateExportSlipPage --> WarehouseStaff : Display "Inventory document code already exists."
else Successful Update
    InventoryDocumentService -> InventoryDocumentService : ensureEditable(doc)
    InventoryDocumentService -> InventoryDocumentRepository : existsByDocCodeAndIdNot(requestedCode, id)
    activate InventoryDocumentRepository
    InventoryDocumentRepository -> Database : Query existence
    activate Database
    Database --> InventoryDocumentRepository : false
    deactivate Database
    InventoryDocumentRepository --> InventoryDocumentService : false
    deactivate InventoryDocumentRepository
    
    InventoryDocumentService -> InventoryDocumentService : updateBaseDocument & reload lines
    InventoryDocumentService -> InventoryDocumentRepository : save(doc)
    activate InventoryDocumentRepository
    InventoryDocumentRepository -> Database : Update InventoryDocument & lines
    activate Database
    Database --> InventoryDocumentRepository : Saved Entity
    deactivate Database
    InventoryDocumentRepository --> InventoryDocumentService : Saved Entity
    deactivate InventoryDocumentRepository
    
    InventoryDocumentService -> InventoryDocumentService : Map entity to DTO
    InventoryDocumentService --> InventoryDocumentController : InventoryDocumentResponse
    deactivate InventoryDocumentService
    
    InventoryDocumentController -> Database : auditLogService.logEvent(..., "SUCCESS", "Cập nhật phiếu xuất kho ...", ...)
    activate Database
    Database --> InventoryDocumentController : saved
    deactivate Database
    
    InventoryDocumentController --> UpdateExportSlipPage : 200 OK (ApiResponse with success DTO)
    deactivate InventoryDocumentController
    
    UpdateExportSlipPage --> WarehouseStaff : Display "Update data successfully." and redirect
    deactivate UpdateExportSlipPage
end

@enduml
