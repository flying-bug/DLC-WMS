@startuml
title Sequence Diagram: UC11 - Update Information

actor "Admin" as User
boundary "EditUserPage" as Page
control "UserController" as Controller
control "UserService" as Service
entity "UserRepository" as Repository
database "Database" as Database

User -> Page : Edit account information\nClick "Save"
activate Page

Page -> Controller : PUT /api/v1/users/{id}
activate Controller

Controller -> Service : updateUser(id, userDto)
activate Service

Service -> Repository : findById(id)
activate Repository

Repository -> Database : SELECT * FROM users WHERE id = ?
activate Database
Database --> Repository : User data / null
deactivate Database

Repository --> Service : User / null
deactivate Repository

alt User Not Found
    Service --> Controller : throws Exception
    Controller --> Page : 404 Error Response
    Page --> User : Hiển thị thông báo lỗi (Tài khoản không tồn tại)

else User Found
    Service -> Service : Validate inputs\n(email/phone format & uniqueness)

    alt Validation Failed
        Service --> Controller : throws Exception
        Controller --> Page : 400 Error Response
        Page --> User : Hiển thị thông báo lỗi\n(Email/SĐT không hợp lệ hoặc đã tồn tại)

    else Validation Passed
        Service -> Repository : save(user)
        activate Repository
        
        Repository -> Database : UPDATE users SET ... WHERE id = ?
        activate Database
        Database --> Repository : Saved
        deactivate Database
        
        Repository --> Service : User Entity
        deactivate Repository
        
        Service --> Controller : UserDto
        deactivate Service
        
        Controller --> Page : 200 OK (ApiResponse)
        deactivate Controller
        
        Page --> User : Hiển thị thông báo (Cập nhật thành công)
        deactivate Page
    end
end

@enduml
