@startuml

autonumber

actor "Staff" as Actor
boundary "UpdateAssemblyOrderPage" as Page
control "AssemblyOrderController" as Controller
participant "AssemblyOrderService" as Service
participant "AssemblyOrderRepository" as Repository
participant "AssemblyBomRepository" as BomRepository
database "duylongcomputer" as Database

Actor -> Page: Modify order details and submit\n(quantity, bomId, notes)
activate Page

Page -> Controller: PUT /api/v1/assembly-orders/{id} (UpdateOrderRequest)
activate Controller

alt Validation Error
    Controller -> Controller: validateRequest(request)
    Controller --> Page: 400 Bad Request (Validation details)
    deactivate Controller
    Page --> Actor: Displaying an error: Invalid data error
else Valid Request
    Controller -> Service: updateAssemblyOrder(id, request)
    activate Service

    Service -> Repository: findById(id)
    activate Repository
    
    Repository -> Database: SELECT FROM ASSEMBLY_ORDERS \nLEFT JOIN ASSEMBLY_ORDER_LINES
    activate Database
    
    Database --> Repository: Existing Order Data
    deactivate Database
    
    Repository --> Service: Optional[AssemblyOrder]
    deactivate Repository
    
    alt Order Not Found
        Service --> Controller: ResourceNotFoundException (Order not found)
        deactivate Service
        
        Controller --> Page: 404 Not Found (Error message)
        deactivate Controller
        
        Page --> Actor: Displaying an error: The assembly/disassembly command was not found.
    else Order Found
        Service -> Service: validateUpdatability(existingOrder)
        note right: Ensure order status is PENDING.\nCannot update COMPLETED/CANCELLED
        
        alt Cannot Update (e.g., Status != PENDING)
            Service --> Controller: IllegalStateException (Invalid status)
            deactivate Service
            
            Controller --> Page: 400 Bad Request (Invalid status)
            deactivate Controller
            
            Page --> Actor: Displaying an error: The assembly/disassembly command cannot be updated.
        else Can Update
            opt BOM or Quantity changed
                Service -> BomRepository: findById(request.bomId)
                activate BomRepository
                
                BomRepository -> Database: SELECT FROM ASSEMBLY_BOMS
                activate Database
                Database --> BomRepository: BOM Details
                deactivate Database
                
                BomRepository --> Service: Optional[AssemblyBom]
                deactivate BomRepository
                
                Service -> Service: recalculateLines(existingOrder, newBom, newQuantity)
                note right: Clear old components and recalculate\nbased on new BOM or Quantity
            end
            
            Service -> Service: updateEntity(existingOrder, request)
            
            Service -> Repository: save(existingOrder)
            activate Repository
            
            Repository -> Database: UPDATE ASSEMBLY_ORDERS
            activate Database
            Database --> Repository: Updated Order Result
            deactivate Database
            
            Repository -> Database: DELETE/INSERT/UPDATE ASSEMBLY_ORDER_LINES
            activate Database
            Database --> Repository: Updated Lines Result
            deactivate Database
            
            Repository --> Service: Saved AssemblyOrder
            deactivate Repository
            
            Service -> Service: mapToDTO(Saved AssemblyOrder)
            
            Service --> Controller: AssemblyOrderDetailDTO
            deactivate Service
            
            Controller --> Page: 200 OK (AssemblyOrderDetailDTO)
            deactivate Controller
            
            Page --> Actor: Displaying a message: The assembly/disassembly command was successfully updated.
        end
    end
end

deactivate Page

@enduml
