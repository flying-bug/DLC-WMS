@startuml
title Sequence Diagram: UC13 - Update Functional Permissions

actor "Admin" as User
boundary "PermissionsPage" as Page
control "UserController" as Controller
control "UserService" as Service
entity "Repository" as Repository
database "Database" as Database

User -> Page : Select permissions\nClick "Save"
activate Page

Page -> Controller : PUT /api/v1/users/{id}/permissions\n(permissionCodes)
activate Controller

Controller -> Service : updatePermissions(id, codes)
activate Service

Service -> Repository : findById(id)
activate Repository

Repository -> Database : SELECT * FROM users WHERE id = ?
activate Database
Database --> Repository : User data / null
deactivate Database

Repository --> Service : User / null
deactivate Repository

alt User Not Found
    Service --> Controller : throws Exception
    Controller --> Page : 404 Error Response
    Page --> User : Hiển thị thông báo lỗi (Tài khoản không tồn tại)

else User Found
    Service -> Service : Check if User has STAFF role

    alt User is not STAFF
        Service --> Controller : throws Exception
        Controller --> Page : 400 Error Response
        Page --> User : Hiển thị thông báo lỗi\n(Chỉ được phân quyền cho tài khoản STAFF)

    else User is STAFF
        loop For each permissionCode
            Service -> Repository : findByCode(code)
            activate Repository
            Repository -> Database : SELECT * FROM permissions WHERE code = ?
            activate Database
            Database --> Repository : Permission data
            deactivate Database
            Repository --> Service : Permission Entity
            deactivate Repository
        end

        Service -> Repository : save(user)
        activate Repository
        
        Repository -> Database : UPDATE users / INSERT INTO user_permissions
        activate Database
        Database --> Repository : Saved
        deactivate Database
        
        Repository --> Service : User Entity
        deactivate Repository
        
        Service --> Controller : void
        deactivate Service
        
        Controller --> Page : 200 OK (ApiResponse)
        deactivate Controller
        
        Page --> User : Hiển thị thông báo (Phân quyền thành công)
        deactivate Page
    end
end

@enduml
