@startuml

autonumber

actor "Manager/Staff" as Actor
boundary "UpdateRepairTicketPage" as Page
control "RepairTicketController" as Controller
participant "RepairTicketService" as Service
participant "RepairTicketRepository" as Repository
participant "SerialNumberRepository" as SerialRepo
database "duylongcomputer" as Database

Actor -> Page: Modify repair ticket details and submit\n(status, resolution notes, cost, etc.)
activate Page

Page -> Controller: PUT /api/v1/repair-tickets/{id} (UpdateRepairTicketRequest)
activate Controller

alt Validation Error
    Controller -> Controller: validateRequest(request)
    Controller --> Page: 400 Bad Request (Validation details)
    deactivate Controller
    
    Page --> Actor: Hiển thị lỗi dữ liệu đầu vào không hợp lệ
else Valid Request
    Controller -> Service: updateRepairTicket(id, request)
    activate Service

    Service -> Repository: findById(id)
    activate Repository
    
    Repository -> Database: SELECT FROM REPAIR_TICKETS \nLEFT JOIN WARRANTIES
    activate Database
    
    Database --> Repository: Existing Ticket Data
    deactivate Database
    
    Repository --> Service: Optional[RepairTicket]
    deactivate Repository
    
    alt Ticket Not Found
        Service --> Controller: ResourceNotFoundException
        deactivate Service
        
        Controller --> Page: 404 Not Found (Error message)
        deactivate Controller
        
        Page --> Actor: Hiển thị lỗi không tìm thấy phiếu sửa chữa
    else Ticket Found
        Service -> Service: validateUpdatability(existingTicket)
        note right: Ensure the ticket is currently active.\nCannot update if already COMPLETED or CANCELLED.
        
        alt Cannot Update
            Service --> Controller: IllegalStateException (Ticket finalized)
            deactivate Service
            
            Controller --> Page: 400 Bad Request (Invalid Status)
            deactivate Controller
            
            Page --> Actor: Hiển thị lỗi không thể cập nhật phiếu đã đóng
        else Can Update
            Service -> Service: updateEntity(existingTicket, request)
            
            Service -> Repository: save(existingTicket)
            activate Repository
            
            Repository -> Database: UPDATE REPAIR_TICKETS
            activate Database
            
            Database --> Repository: Updated Ticket
            deactivate Database
            
            Repository --> Service: Saved RepairTicket
            deactivate Repository
            
            opt Ticket Status changed to COMPLETED/CANCELLED
                Service -> SerialRepo: updateStatus(warranty.serialId, 'AVAILABLE')
                activate SerialRepo
                
                SerialRepo -> Database: UPDATE SERIAL_NUMBERS
                activate Database
                
                Database --> SerialRepo: Update Result
                deactivate Database
                
                SerialRepo --> Service: Success
                deactivate SerialRepo
                note right: Release the device from REPAIRING status
            end
            
            Service -> Service: mapToDTO(Saved RepairTicket)
            
            Service --> Controller: RepairTicketDetailDTO
            deactivate Service
            
            Controller --> Page: 200 OK (RepairTicketDetailDTO)
            deactivate Controller
            
            Page --> Actor: Hiển thị thông báo cập nhật thành công\nvà tải lại trang chi tiết
        end
    end
end

deactivate Page

@enduml
