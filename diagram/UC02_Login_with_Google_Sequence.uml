@startuml
title Sequence Diagram: UC02 - Login with Google

actor "User" as User
boundary "LoginPage" as Page
control "AuthController" as Controller
control "AuthService" as Service
entity "UserRepository" as Repository
database "Database" as Database

User -> Page : Click "Login with Google"\nand authenticate
activate Page

Page -> Controller : POST /api/v1/auth/login-google\n(Google Token)
activate Controller

Controller -> Service : loginWithGoogle(token)
activate Service

Service -> Service : Verify Google token and extract email

alt Invalid Google Token
    Service --> Controller : throws Exception
    Controller --> Page : 400 Error Response
    Page --> User : Hiển thị thông báo lỗi (Đăng nhập Google thất bại)

else Valid Google Token
    Service -> Repository : findByEmail(email)
    activate Repository

    Repository -> Database : SELECT * FROM users WHERE email = ?
    activate Database
    Database --> Repository : User data / null
    deactivate Database

    Repository --> Service : User / null
    deactivate Repository

    alt User Not Found
        Service --> Controller : throws Exception
        Controller --> Page : 400 Error Response
        Page --> User : Hiển thị thông báo lỗi (Tài khoản không tồn tại)

    else User Found
        alt Account Locked (status != APPROVED)
            Service --> Controller : throws Exception
            Controller --> Page : 403 Error Response
            Page --> User : Hiển thị thông báo lỗi (Tài khoản bị khóa)
            
        else Valid Account
            Service --> Controller : return JwtResponse
            deactivate Service
            
            Controller --> Page : 200 OK (ApiResponse)
            deactivate Controller
            
            Page --> User : Đăng nhập thành công,\nchuyển hướng Dashboard
            deactivate Page
        end
    end
end

@enduml
