@startuml

autonumber

actor "Manager" as Actor
boundary "InventoryBalanceReportPage" as Page
control "ReportController" as Controller
participant "InventoryReportService" as Service
participant "InventoryBalanceRepository" as Repository
database "duylongcomputer" as Database

Actor -> Page: Request to view Inventory On-Hand Balance Report\n(apply filters: warehouse, category, date)
activate Page

Page -> Controller: GET /api/v1/reports/inventory-balance (filters)
activate Controller

alt Validation Error
    Controller -> Controller: validateParams(filters)
    Controller --> Page: 400 Bad Request (Validation details)
    deactivate Controller
    
    Page --> Actor: Hiển thị lỗi thông số tìm kiếm không hợp lệ
else Valid Parameters
    Controller -> Service: getInventoryBalanceReport(filters)
    activate Service

    Service -> Repository: fetchBalanceData(filters)
    activate Repository
    
    Repository -> Database: SELECT product_id, warehouse_id, SUM(quantity) \nFROM INVENTORY_BALANCES \nLEFT JOIN PRODUCT_VARIANTS \n(with filters) GROUP BY product_id, warehouse_id
    activate Database
    
    Database --> Repository: Aggregated Result Set
    deactivate Database
    
    Repository --> Service: List[InventoryBalanceData]
    deactivate Repository
    
    Service -> Service: processAndFormat(List[InventoryBalanceData])
    note right: Calculate total valuations,\naggregate by categories/warehouses
    
    Service --> Controller: InventoryBalanceReportDTO
    deactivate Service
    
    Controller --> Page: 200 OK (InventoryBalanceReportDTO)
    deactivate Controller
    
    Page --> Actor: Hiển thị báo cáo tồn kho hiện tại (bảng số liệu, biểu đồ)
end

opt Export Report to Excel/PDF
    Actor -> Page: Click "Export" button
    Page -> Controller: GET /api/v1/reports/inventory-balance/export (filters, format)
    activate Controller
    
    Controller -> Service: exportInventoryBalanceReport(filters, format)
    activate Service
    
    Service -> Repository: fetchBalanceData(filters)
    activate Repository
    Repository --> Service: List[InventoryBalanceData]
    deactivate Repository
    
    Service -> Service: generateFile(List[InventoryBalanceData], format)
    note right: Create Excel/PDF file with formatting
    
    Service --> Controller: byte[] (File stream)
    deactivate Service
    
    Controller --> Page: 200 OK (Content-Type: application/octet-stream)
    deactivate Controller
    
    Page --> Actor: Tải xuống file báo cáo tồn kho thành công
end

deactivate Page

@enduml
