@startuml
title Sequence Diagram: UC05 - Forgot Password

actor "User" as User
boundary "ForgotPasswordPage" as Page
control "AuthController" as Controller
control "AuthService" as Service
entity "UserRepository" as Repository
database "Database" as Database

== Step 1: Request OTP ==
User -> Page : Input email\nClick "Send OTP"
activate Page

Page -> Controller : POST /api/v1/auth/forgot-password/request-otp
activate Controller

Controller -> Service : requestOtp(email)
activate Service

Service -> Repository : findByEmail(email)
activate Repository

Repository -> Database : SELECT * FROM users WHERE email = ?
activate Database
Database --> Repository : User data / null
deactivate Database

Repository --> Service : User / null
deactivate Repository

alt User Not Found
    Service --> Controller : throws Exception
    Controller --> Page : 400 Error Response
    Page --> User : Hiển thị thông báo lỗi (Tài khoản không tồn tại)

else User Found
    Service -> Service : Generate OTP and save to memory
    Service -> Service : Send OTP via Email
    
    Service --> Controller : void
    deactivate Service
    
    Controller --> Page : 200 OK
    deactivate Controller
    
    Page --> User : Chuyển sang bước nhập mã OTP
end

== Step 2: Verify OTP ==
User -> Page : Input OTP\nClick "Verify"

Page -> Controller : POST /api/v1/auth/forgot-password/verify-otp
activate Controller

Controller -> Service : verifyOtp(email, otp)
activate Service

Service -> Service : Check OTP in memory

alt Invalid or Expired OTP
    Service --> Controller : throws Exception
    Controller --> Page : 400 Error Response
    Page --> User : Hiển thị thông báo lỗi (Mã OTP không hợp lệ/hết hạn)

else Valid OTP
    Service --> Controller : void
    deactivate Service
    
    Controller --> Page : 200 OK
    deactivate Controller
    
    Page --> User : Chuyển sang bước đặt mật khẩu mới
end

== Step 3: Reset Password ==
User -> Page : Input new password\nClick "Reset Password"

Page -> Page : Validate new password complexity\n(letters, numbers, special characters)

alt Invalid Password Complexity
    Page --> User : Hiển thị thông báo lỗi\n(Mật khẩu phải chứa số, chữ và ký tự đặc biệt)

else Valid Password
    Page -> Controller : POST /api/v1/auth/forgot-password/reset
    activate Controller

    Controller -> Service : resetPasswordWithOtp(email, otp, newPassword)
    activate Service

    Service -> Service : verifyOtp(email, otp)
    
    Service -> Repository : findByEmail(email)
    activate Repository
    
    Repository -> Database : SELECT * FROM users WHERE email = ?
    activate Database
    Database --> Repository : User data
    deactivate Database
    
    Repository --> Service : User
    deactivate Repository
    
    Service -> Repository : save(user)
    activate Repository
    
    Repository -> Database : UPDATE users SET password_hash = ? WHERE id = ?
    activate Database
    Database --> Repository : Saved
    deactivate Database
    
    Repository --> Service : Saved User
    deactivate Repository
    
    Service -> Service : Remove OTP from memory
    
    Service --> Controller : void
    deactivate Service
    
    Controller --> Page : 200 OK
    deactivate Controller
    
    Page --> User : Hiển thị thông báo (Đặt lại MK thành công),\nchuyển hướng Đăng nhập
    deactivate Page
end

@enduml
