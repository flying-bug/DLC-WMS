@startuml

autonumber

actor "Staff" as Actor
boundary "AssemblyHistoryPage" as Page
control "AssemblyOrderController" as Controller
participant "AssemblyOrderService" as Service
participant "AssemblyOrderRepository" as Repository
database "duylongcomputer" as Database

Actor -> Page: Request to view assembly/disassembly history
activate Page

Page -> Controller: GET /api/v1/assembly-orders (filters, pagination)
activate Controller

alt Validation Error (e.g., Invalid date range)
    Controller -> Controller: validateParams(filters)
    Controller --> Page: 400 Bad Request (Validation details)
    deactivate Controller
    Page --> Actor: Displaying an error: Invalid search parameters
else Valid Parameters
    Controller -> Service: getAssemblyOrders(filters, pageable)
    activate Service

    Service -> Repository: findAll(specification, pageable)
    activate Repository

    Repository -> Database: SELECT FROM ASSEMBLY_ORDERS \n(with filters: type, dates, status)
    activate Database
    
    Database --> Repository: Result Set
    deactivate Database

    Repository --> Service: Page[AssemblyOrder]
    deactivate Repository

    Service -> Service: mapToDTOs(Page[AssemblyOrder])
    
    Service --> Controller: PageResponse[AssemblyOrderDTO]
    deactivate Service

    Controller --> Page: 200 OK (PageResponse)
    deactivate Controller

    Page --> Actor: Display assembly/disassembly history list
end

opt View details of a specific order
    Actor -> Page: Click on a specific assembly order
    Page -> Controller: GET /api/v1/assembly-orders/{id}
    activate Controller
    
    Controller -> Service: getAssemblyOrderById(id)
    activate Service
    
    Service -> Repository: findById(id)
    activate Repository
    
    Repository -> Database: SELECT FROM ASSEMBLY_ORDERS \nJOIN ASSEMBLY_ORDER_LINES
    activate Database
    
    Database --> Repository: AssemblyOrder (with lines)
    deactivate Database
    
    alt Order Not Found
        Repository --> Service: Empty Optional
        deactivate Repository
        Service --> Controller: ResourceNotFoundException
        deactivate Service
        Controller --> Page: 404 Not Found (Error message)
        deactivate Controller
        Page --> Actor: Displays a history error.
    else Order Found
        Repository --> Service: Optional[AssemblyOrder]
    deactivate Repository
        
        Service -> Service: mapToDetailDTO(AssemblyOrder)
        Service --> Controller: AssemblyOrderDetailDTO
        deactivate Service
        
        Controller --> Page: 200 OK (AssemblyOrderDetailDTO)
        deactivate Controller
        
        Page --> Actor: Display detailed assembly/disassembly history.
    end
end

deactivate Page
@enduml
