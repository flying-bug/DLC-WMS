@startuml

autonumber

actor "Staff" as Actor
boundary "RepairTicketListPage" as Page
control "RepairTicketController" as Controller
participant "RepairTicketService" as Service
participant "RepairTicketRepository" as Repository
database "duylongcomputer" as Database

Actor -> Page: Request to view repair ticket list\n(apply filters: status, dates, warranty)
activate Page

Page -> Controller: GET /api/v1/repair-tickets (filters, pagination)
activate Controller

alt Validation Error (e.g., Invalid date range)
    Controller -> Controller: validateParams(filters)
    Controller --> Page: 400 Bad Request (Validation details)
    deactivate Controller
    
    Page --> Actor: Displaying an error: Invalid search parameters error
else Valid Parameters
    Controller -> Service: getRepairTickets(filters, pageable)
    activate Service

    Service -> Repository: findAll(specification, pageable)
    activate Repository

    Repository -> Database: SELECT FROM REPAIR_TICKETS \nLEFT JOIN WARRANTIES \nLEFT JOIN SERIAL_NUMBERS \n(with dynamic filters)
    activate Database
    
    Database --> Repository: Result Set
    deactivate Database

    Repository --> Service: Page[RepairTicket]
    deactivate Repository

    Service -> Service: mapToDTOs(Page[RepairTicket])
    
    Service --> Controller: PageResponse[RepairTicketDTO]
    deactivate Service

    Controller --> Page: 200 OK (PageResponse)
    deactivate Controller

    Page --> Actor: Displaying a message: The repair ticket list was successfully displayed.
end

opt View details of a specific repair ticket
    Actor -> Page: Click on a specific repair ticket
    Page -> Controller: GET /api/v1/repair-tickets/{id}
    activate Controller
    
    Controller -> Service: getRepairTicketById(id)
    activate Service
    
    Service -> Repository: findById(id)
    activate Repository
    
    Repository -> Database: SELECT FROM REPAIR_TICKETS \nLEFT JOIN WARRANTIES \nLEFT JOIN SERIAL_NUMBERS
    activate Database
    
    Database --> Repository: RepairTicket Data
    deactivate Database
    
    alt Ticket Not Found
        Repository --> Service: Empty Optional
        deactivate Repository
        
        Service --> Controller: ResourceNotFoundException
        deactivate Service
        
        Controller --> Page: 404 Not Found (Error message)
        deactivate Controller
        
        Page --> Actor: Displaying an error: The repair ticket was not found.
    else Ticket Found
        Repository --> Service: Optional[RepairTicket]
        deactivate Repository
        
        Service -> Service: mapToDetailDTO(RepairTicket)
        Service --> Controller: RepairTicketDetailDTO
        deactivate Service
        
        Controller --> Page: 200 OK (RepairTicketDetailDTO)
        deactivate Controller
        
        Page --> Actor: Displaying a message: The repair ticket details were successfully displayed.
    end
end

deactivate Page

@enduml
