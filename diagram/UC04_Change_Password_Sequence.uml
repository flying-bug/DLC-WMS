@startuml
title Sequence Diagram: UC04 - Change Password

actor "User" as User
boundary "ChangePasswordPage" as Page
control "AuthController" as Controller
control "AuthService" as Service
entity "UserRepository" as Repository
database "Database" as Database

User -> Page : Input old password, new password\nClick Submit
activate Page

Page -> Page : Validate new password complexity\n(letters, numbers, special characters)

alt Invalid Password Complexity
    Page --> User : Hiển thị thông báo lỗi\n(Mật khẩu phải chứa số, chữ và ký tự đặc biệt)

else Valid Password
    Page -> Controller : POST /api/v1/auth/change-password
    activate Controller

    Controller -> Service : changePassword(request)
    activate Service

    Service -> Repository : findByUsername(currentUsername)
    activate Repository

    Repository -> Database : SELECT * FROM users WHERE username = ?
    activate Database
    Database --> Repository : User data
    deactivate Database

    Repository --> Service : User
    deactivate Repository

    Service -> Service : Verify old password

    alt Incorrect Old Password
        Service --> Controller : throws Exception
        Controller --> Page : 400 Error Response
        Page --> User : Hiển thị thông báo lỗi (Mật khẩu cũ không chính xác)

    else Correct Old Password
        Service -> Repository : save(user)
        activate Repository
        
        Repository -> Database : UPDATE users SET password_hash = ? WHERE id = ?
        activate Database
        Database --> Repository : Saved
        deactivate Database
        
        Repository --> Service : Saved User
        deactivate Repository
        
        Service --> Controller : void
        deactivate Service
        
        Controller --> Page : 200 OK (ApiResponse)
        deactivate Controller
        
        Page --> User : Hiển thị thông báo (Đổi mật khẩu thành công)
        deactivate Page
    end
end

@enduml
